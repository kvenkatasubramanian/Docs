# Copy to rec-recover.env and adjust. Flags on the command line override these.
# Namespace and REC name are OPTIONAL. Leave them empty (or commented out) and the script
# detects the RedisEnterpriseCluster from the cluster you are logged in to with `oc login`.
# Set them only to pin a specific cluster when several RECs exist.
# NS="redis-prod"
# REC="rec"
REDIS_CONTAINER="redis-enterprise-node"
OPERATOR_DEPLOYMENT="redis-enterprise-operator"

# Persistence layout inside the Redis Enterprise pod (documented defaults)
PERSIST_ROOT="/var/opt/redislabs/persist"
CCS_FILE="ccs/ccs-redis.rdb"
DB_PERSIST_DIR="redis"
# Set only if DB persistence files were restored to a non-default location:
# RECOVERY_PATH="/var/opt/redislabs/persist/restored"

# Timeouts (seconds)
RL_TIMEOUT=30            # rladmin status etc. (inside container)
RL_RECOVER_TIMEOUT=3600  # rladmin recover db
TIMEOUT_REC=1800         # REC -> Running
TIMEOUT_POD=900          # each pod -> Ready
POLL_INTERVAL=15
TOKEN_TTL=14400          # precheck approval token validity

# Backup
BACKUP_MAX_BYTES=21474836480   # skip per-pod DB-file archive above 20 GiB (use your backup platform instead)

# Active-Active decisions (comma-separated CRDB names). Leave empty to decide via flags at run time.
# AA_DATA_BEARING="crdb-orders"
# AA_CONFIG_ONLY="crdb-sessions,crdb-catalog"
