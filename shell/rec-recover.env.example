# rec-recover.env - optional settings for rec-recover.sh
# Copy to rec-recover.env next to the script. Everything here has a sensible default;
# most people never need this file.

# ---- Target ---------------------------------------------------------------------
# Detected automatically from the cluster you are logged in to with `oc login`.
# Set these only to pin one cluster when several RedisEnterpriseClusters exist.
# NS="redis-enterprise"
# REC="demo-cert-cluster"
# REDIS_CONTAINER="redis-enterprise-node"
# OPERATOR_DEPLOYMENT="redis-enterprise-operator"

# ---- Customer CA certificate -----------------------------------------------------
# recover-cluster and all need this file in the current directory or next to rec-recover.sh and stop
# immediately if it is missing. After clusterRecovery is patched, its content is appended to the bottom of
# TRUSTED_CA_PATH in each pod as the pod comes up, and once more on every pod after the rebuild, wherever
# the certificate is not already present. Every append is followed at once by `supervisorctl restart all`
# on that pod.
# CA_CERT_FILE="O1_G2_Certificate.pem"                  # file name, or an absolute path
# TRUSTED_CA_PATH="/etc/opt/redislabs/trusted_ca.pem"   # file in the pod that receives the certificate
# RESTART_AFTER_RESTORE=true

# ---- Cluster master after recovery ----------------------------------------------
# After the rebuild (and the certificate step) the master is moved to another node with
# `rladmin cluster master set <id>`.
# SWITCH_MASTER=true
# NEW_MASTER_NODE=2           # node id to promote; empty = lowest healthy node that is not the current master

# ---- Backup location and size -----------------------------------------------------
# ARTIFACT_ROOT="/mnt/bigdisk/rec-recovery"   # where reports and backup archives are written (default: ./artifacts)
# BACKUP_MAX_BYTES=21474836480                # skip a pod's database archive above this size (20 GiB)

# ---- Timeouts (seconds) ----------------------------------------------------------
# TIMEOUT_REC=1800          # wait for the REC to reach Running
# TIMEOUT_POD=900           # wait for each pod to become Ready
# RL_RECOVER_TIMEOUT=3600   # each rladmin recover db (raise for very large databases)
# RL_TIMEOUT=30             # ordinary rladmin calls
# POLL_INTERVAL=15

# ---- Advanced --------------------------------------------------------------------
# RECOVERY_PATH="/var/opt/redislabs/persist/restored"   # database files restored to a non-default path
# ALLOW_UNBACKED=true       # continue even if the backup step could not archive everything
# STRICT_MODULES=true       # treat duplicate module versions as blocking
# NO_COLOR=1                # plain output
